---
import { ClientRouter } from "astro:transitions";
import Logo from "../components/Logo.astro";
import OrganicPattern from "../components/OrganicPattern.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  theme?: string;
  home?: boolean;
  cam?: boolean;
  patternColors?: string[];
  patternVariant?: number;
  animalColors?: string[];
}

const {
  title,
  description = "CRIPSIS — imperceptibilidad a los sentidos",
  theme = "home-theme",
  home = false,
  cam = false,
  patternColors,
  patternVariant = 0,
  animalColors,
} = Astro.props;

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;
const animalStyle = animalColors?.length >= 3
  ? `--animal-color-a:${animalColors[0]};--animal-color-b:${animalColors[1]};--animal-color-c:${animalColors[2]};--page-background:linear-gradient(135deg,color-mix(in srgb,${animalColors[0]} 82%,${animalColors[1]} 18%),color-mix(in srgb,${animalColors[1]} 68%,${animalColors[2]} 32%),${animalColors[2]})`
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body
    class:list={[theme, { "home-page": home, "cam-page-body": cam }]}
    style={animalStyle}
  >
    {!home && !cam && patternColors && (
      <OrganicPattern
        colors={patternColors}
        variant={patternVariant}
        class="site-pattern"
      />
    )}
    <div class="site-shell">
      <header class="site-header">
        <nav class="top-nav" aria-label="Navegación principal">
          {!home && <Logo href={base} />}
          {!home && (
            <div class="nav-links" aria-label="Navegación de secciones">
              <div class="section-links">
                <a href={`${base}aire/`}>aire</a>
                <a href={`${base}agua/`}>agua</a>
                <a href={`${base}tierra/`}>tierra</a>
              </div>
              <a class="cam-link" href={`${base}cam/`} aria-label="Abrir experiencia con cámara">
                cam
              </a>
            </div>
          )}
        </nav>
        <slot name="hero" />
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer>
        <p>&copy; 2026 CRIPSIS. Todos los derechos reservados.</p>
      </footer>
    </div>
  </body>
</html>
