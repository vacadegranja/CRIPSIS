---
import { ClientRouter } from "astro:transitions";
import Logo from "../components/Logo.astro";
import ShaderStage from "../components/ShaderStage.astro";
import Welcome from "../components/Welcome.astro";
import { elements } from "../data/animals.js";
import "../styles/global.css";
import "../styles/tokens.css";

type PageKind = "home" | "element" | "animal" | "info" | "cam" | "page";

interface Props {
  title: string;
  description?: string;
  theme?: string;
  home?: boolean;
  cam?: boolean;
  patternColors?: string[];
  patternPalettes?: string[][];
  patternVariant?: number;
  animalColors?: string[];
  /** Tipo de vista: decide la timeline de entrada y los tokens CSS por vista. */
  page?: PageKind;
}

const {
  title,
  description = "CRIPSIS — imperceptibilidad a los sentidos",
  theme = "home-theme",
  home = false,
  cam = false,
  patternColors,
  patternPalettes,
  patternVariant = 0,
  animalColors,
  page = home ? "home" : cam ? "cam" : "page",
} = Astro.props;

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;
const animalStyle = animalColors && animalColors.length >= 3
  ? `--animal-color-a:${animalColors[0]};--animal-color-b:${animalColors[1]};--animal-color-c:${animalColors[2]};--page-background:linear-gradient(135deg,color-mix(in srgb,${animalColors[0]} 82%,${animalColors[1]} 18%),color-mix(in srgb,${animalColors[1]} 68%,${animalColors[2]} 32%),${animalColors[2]})`
  : undefined;

// Paletas para el shader persistente y los tokens CSS (--page-a/b/c).
const defaultPalettes = [
  elements.aire.patternColors,
  elements.agua.patternColors,
  elements.tierra.patternColors,
];
const shaderPalettes = patternPalettes ?? (patternColors ? [patternColors] : defaultPalettes);
const [pageA, pageB, pageC] = shaderPalettes[0];
const rootStyle = `--page-a:${pageA};--page-b:${pageB};--page-c:${pageC}`;
const elementLinks = (["aire", "tierra", "agua"] as const).map((key) => ({
  key,
  palette: elements[key].patternColors.join(","),
  variant: elements[key].patternVariant,
}));
---

<!doctype html>
<html
  lang="es"
  class="motion-pending"
  transition:animate="none"
  data-page={page}
  data-shader-palettes={JSON.stringify(shaderPalettes)}
  data-shader-variant={patternVariant}
  data-shader-opacity={cam ? 0 : 1}
  style={rootStyle}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <ClientRouter />
    <noscript>
      <style>
        html.motion-pending .site-shell > * { visibility: visible !important; animation: none !important; }
      </style>
    </noscript>
  </head>
  <body
    class:list={[theme, { "home-page": home, "cam-page-body": cam }]}
    style={animalStyle}
  >
    <Welcome />
    <ShaderStage />
    <div class="site-shell">
      <header class="site-header">
        <nav class="top-nav" aria-label="Navegación principal">
          {!home && <Logo href={base} />}
          <button
            class="nav-menu-toggle"
            type="button"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="site-nav-links"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
          <div
            id="site-nav-links"
            class:list={["nav-links", { "home-nav-links": home }]}
            aria-label="Navegación de secciones"
          >
            {home ? (
              <>
                <a class="info-link" href={`${base}info/`}>info</a>
                <a class="cam-link" href={`${base}cam/`} aria-label="Abrir experiencia con cámara">
                  cam
                </a>
              </>
            ) : (
              <>
                <div class="section-links">
                  <div class="elements-dropdown">
                    <button
                      class="elements-dropdown__toggle"
                      type="button"
                      aria-expanded="false"
                      aria-controls="elements-dropdown-menu"
                    >
                      elementos
                    </button>
                    <div
                      class="elements-dropdown__menu"
                      id="elements-dropdown-menu"
                      aria-hidden="true"
                      inert
                    >
                      {elementLinks.map(({ key, palette, variant }) => (
                        <a
                          href={`${base}${key}/`}
                          data-shader-hover={palette}
                          data-shader-variant={variant}
                        >
                          {key}
                        </a>
                      ))}
                    </div>
                  </div>
                  <a class="info-link" href={`${base}info/`}>info</a>
                </div>
                <a class="cam-link" href={`${base}cam/`} aria-label="Abrir experiencia con cámara">
                  cam
                </a>
              </>
            )}
          </div>
        </nav>
        <slot name="hero" />
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer>
        <p>&copy; 2026 CRIPSIS. Todos los derechos reservados.</p>
      </footer>
    </div>
  </body>
</html>

<script>
  function initializeNavigation() {
    document.querySelectorAll<HTMLButtonElement>(".nav-menu-toggle").forEach((button) => {
      if (button.dataset.menuReady === "true") return;
      button.dataset.menuReady = "true";

      const menu = document.getElementById(button.getAttribute("aria-controls") || "");
      if (!menu) return;
      const elementsToggle = menu.querySelector<HTMLButtonElement>(".elements-dropdown__toggle");
      const elementsMenu = menu.querySelector<HTMLElement>(".elements-dropdown__menu");

      const closeMenu = () => {
        menu.classList.remove("is-open");
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", "Abrir menú");
        elementsMenu?.removeAttribute("data-open");
        elementsMenu?.setAttribute("aria-hidden", "true");
        elementsMenu?.setAttribute("inert", "");
        elementsToggle?.setAttribute("aria-expanded", "false");
      };

      elementsToggle?.addEventListener("click", () => {
        const isOpen = elementsToggle.getAttribute("aria-expanded") === "true";
        elementsToggle.setAttribute("aria-expanded", String(!isOpen));
        if (isOpen) {
          elementsMenu?.removeAttribute("data-open");
          elementsMenu?.setAttribute("aria-hidden", "true");
          elementsMenu?.setAttribute("inert", "");
        } else {
          elementsMenu?.setAttribute("data-open", "true");
          elementsMenu?.setAttribute("aria-hidden", "false");
          elementsMenu?.removeAttribute("inert");
        }
      });

      button.addEventListener("click", () => {
        const isOpen = button.getAttribute("aria-expanded") === "true";
        if (isOpen) {
          closeMenu();
        } else {
          menu.classList.add("is-open");
          button.setAttribute("aria-expanded", "true");
          button.setAttribute("aria-label", "Cerrar menú");
        }
      });

      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      button.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
      });

      elementsToggle?.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          elementsToggle.setAttribute("aria-expanded", "false");
          elementsMenu?.removeAttribute("data-open");
          elementsMenu?.setAttribute("aria-hidden", "true");
          elementsMenu?.setAttribute("inert", "");
          elementsToggle.focus();
        }
      });
    });
  }

  initializeNavigation();
  document.addEventListener("astro:page-load", initializeNavigation);
</script>
