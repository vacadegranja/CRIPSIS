---
interface Props {
  colors: string[];
  intensity?: number;
  variant?: number;
  class?: string;
}

const {
  colors,
  intensity = 0.82,
  variant = 0,
  class: className = "",
} = Astro.props;
---

<div
  class:list={["organic-pattern", className]}
  data-organic-pattern
  data-colors={colors.join(",")}
  data-intensity={intensity}
  data-variant={variant}
  aria-hidden="true"
>
  <canvas class="organic-pattern__canvas"></canvas>
</div>

<style>
  .organic-pattern {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 1;
  }

  .organic-pattern.site-pattern {
    position: absolute;
    z-index: 0;
  }

  .organic-pattern__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import * as THREE from "three";

  const vertexShader = /* glsl */ `
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `;

  const fragmentShader = /* glsl */ `
    uniform float uTime;
    uniform float uReveal;
    uniform float uPointerActive;
    uniform float uIntensity;
    uniform float uVariant;
    uniform vec2 uResolution;
    uniform vec2 uPointer;
    uniform vec3 uColorA;
    uniform vec3 uColorB;
    uniform vec3 uColorC;
    varying vec2 vUv;

    float hash(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
    }

    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
        mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x),
        f.y
      );
    }

    float fbm(vec2 p) {
      float value = 0.0;
      float amplitude = 0.5;
      for (int i = 0; i < 5; i++) {
        value += noise(p) * amplitude;
        p = p * 2.03 + 17.1;
        amplitude *= 0.5;
      }
      return value;
    }

    void main() {
      float aspect = uResolution.x / max(uResolution.y, 1.0);
      vec2 p = (vUv - 0.5) * vec2(aspect, 1.0);
      float t = uTime * 0.075;

      // Campo de deformación lento para evitar un movimiento mecánico.
      vec2 flow = vec2(
        fbm(p * 2.1 + vec2(t, -t * 0.7)),
        fbm(p * 2.1 + vec2(-t * 0.6, t))
      );
      p += (flow - 0.5) * 0.34;

      // El cursor empuja el campo y curva las líneas en su proximidad.
      vec2 pointer = (uPointer - 0.5) * vec2(aspect, 1.0);
      vec2 delta = p - pointer;
      float d = length(delta);
      float influence = exp(-d * d * 17.0) * uPointerActive;
      vec2 safeDirection = delta / max(d, 0.0001);
      p += safeDirection * influence * 0.10;
      p += vec2(-safeDirection.y, safeDirection.x) * influence * 0.10;

      // Contornos orgánicos tipo laberinto / reacción-difusión.
      vec2 fieldUv = p * 4.1;
      float field = fbm(fieldUv + flow * 1.5);
      field += 0.11 * sin(fieldUv.x * 2.1 + sin(fieldUv.y * 1.7 + t));
      field += 0.07 * sin(fieldUv.y * 2.4 - fieldUv.x * 1.3);

      float bands = abs(fract(field * 9.0) - 0.5);
      float lines = 1.0 - smoothstep(0.035, 0.105, bands);
      float halo = exp(-bands * 17.0);

      float variantBands = 0.0;
      if (uVariant < 0.5) {
        float waves = sin(fieldUv.x * 2.0 + sin(fieldUv.y * 2.4 + t));
        variantBands = 1.0 - smoothstep(0.04, 0.15, abs(waves - 0.08));
        halo += variantBands * 0.20;
      } else if (uVariant < 1.5) {
        vec2 feathers = abs(fract(fieldUv * 0.72) - 0.5);
        float eye = 1.0 - smoothstep(0.12, 0.24, length(feathers));
        variantBands = eye * (0.55 + 0.45 * sin(fieldUv.x * 5.0));
        lines = max(lines, variantBands);
      } else if (uVariant < 2.5) {
        vec2 scales = fract(fieldUv * 1.18) - 0.5;
        float scaleArc = abs(length(scales) - 0.34);
        variantBands = 1.0 - smoothstep(0.025, 0.09, scaleArc);
        lines = max(lines, variantBands);
      } else {
        variantBands = 1.0 - smoothstep(0.02, 0.11, abs(sin((fieldUv.x + fieldUv.y) * 2.2)));
        lines = max(lines, variantBands * 0.68);
      }

      float paletteMix = smoothstep(0.16, 0.82, field);
      vec3 palette = mix(uColorA, uColorB, paletteMix);
      palette = mix(palette, uColorC, smoothstep(0.62, 0.94, field));

      // El patrón aparece desde arriba hacia abajo conforme avanza el scroll.
      float distanceFromTop = 1.0 - vUv.y;
      float revealMask = 1.0 - smoothstep(
        uReveal - 0.035,
        uReveal + 0.035,
        distanceFromTop
      );

      float ink = lines * 0.78 + halo * 0.22;
      float alpha = revealMask * ink * uIntensity;
      vec3 color = palette * (lines * 0.92 + halo * 0.24);
      color += palette * influence * 0.18;

      gl_FragColor = vec4(color, alpha);
    }
  `;

  const initialized = new WeakSet<HTMLCanvasElement>();
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function colorUniform(value: string, fallback: string) {
    try {
      return new THREE.Color(value.trim());
    } catch {
      return new THREE.Color(fallback);
    }
  }

  function initOrganicPatterns() {
    document.querySelectorAll<HTMLElement>("[data-organic-pattern]").forEach((root) => {
      const canvas = root.querySelector<HTMLCanvasElement>("canvas");
      const page = root.parentElement;
      if (!canvas || !page || initialized.has(canvas)) return;
      initialized.add(canvas);

      const colors = (root.dataset.colors || "#c4a060,#e6c98a,#fff0ce").split(",");
      const intensity = Number(root.dataset.intensity || 0.82);
      const variant = Number(root.dataset.variant || 0);
      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.25));
      renderer.setClearColor(0x000000, 0);

      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
      const uniforms = {
        uTime: { value: 0 },
        uReveal: { value: 0 },
        uPointerActive: { value: 0 },
        uIntensity: { value: intensity },
        uVariant: { value: variant },
        uResolution: { value: new THREE.Vector2(1, 1) },
        uPointer: { value: new THREE.Vector2(0.5, 0.5) },
        uColorA: { value: colorUniform(colors[0] || "", "#c4a060") },
        uColorB: { value: colorUniform(colors[1] || "", "#e6c98a") },
        uColorC: { value: colorUniform(colors[2] || "", "#fff0ce") },
      };
      const material = new THREE.ShaderMaterial({
        vertexShader,
        fragmentShader,
        uniforms,
        transparent: true,
        depthWrite: false,
      });
      const geometry = new THREE.PlaneGeometry(2, 2);
      scene.add(new THREE.Mesh(geometry, material));

      let width = 1;
      let height = 1;
      let pointerActive = 0;
      let pointerTarget = new THREE.Vector2(0.5, 0.5);
      let animationFrame = 0;
      const startTime = performance.now();

      const resize = () => {
        const rect = root.getBoundingClientRect();
        width = Math.max(1, rect.width);
        height = Math.max(1, rect.height);
        renderer.setSize(width, height, false);
        uniforms.uResolution.value.set(width, height);
      };

      const onPointerMove = (event: PointerEvent) => {
        const rect = root.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        pointerTarget.set(
          THREE.MathUtils.clamp((event.clientX - rect.left) / rect.width, 0, 1),
          THREE.MathUtils.clamp(1 - (event.clientY - rect.top) / rect.height, 0, 1),
        );
        pointerActive = 1;
      };
      const onPointerLeave = () => { pointerActive = 0; };

      page.addEventListener("pointermove", onPointerMove, { passive: true });
      page.addEventListener("pointerleave", onPointerLeave, { passive: true });
      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(root);
      resizeObserver.observe(page);
      resize();

      const animate = (now: number) => {
        animationFrame = requestAnimationFrame(animate);
        const elapsed = (now - startTime) / 1000;
        const documentHeight = Math.max(
          document.documentElement.scrollHeight,
          document.body.scrollHeight,
          height,
        );
        const scrollReveal =
          (window.scrollY + window.innerHeight * 1.15) / documentHeight;
        const loadProgress = reducedMotion
          ? 0
          : 0.08 * THREE.MathUtils.smoothstep(elapsed, 0, 2.6);
        uniforms.uReveal.value = THREE.MathUtils.clamp(
          Math.max(loadProgress, scrollReveal),
          0,
          1,
        );
        uniforms.uTime.value = reducedMotion ? 0 : elapsed;
        uniforms.uPointer.value.lerp(pointerTarget, 0.13);
        uniforms.uPointerActive.value += (pointerActive - uniforms.uPointerActive.value) * 0.09;
        renderer.render(scene, camera);
      };
      animationFrame = requestAnimationFrame(animate);

      const cleanup = () => {
        cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        page.removeEventListener("pointermove", onPointerMove);
        page.removeEventListener("pointerleave", onPointerLeave);
        geometry.dispose();
        material.dispose();
        renderer.dispose();
        initialized.delete(canvas);
      };
      document.addEventListener("astro:before-swap", cleanup, { once: true });
    });
  }

  document.addEventListener("astro:page-load", initOrganicPatterns);
  initOrganicPatterns();
</script>
