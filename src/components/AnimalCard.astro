---
interface Props {
  href: string;
  name: string;
  image: string | null;
  alt: string;
}

const { href, name, image, alt } = Astro.props;
---

<a class="animal-card" href={href}>
  {image ? <img src={image} alt={alt} loading="lazy" /> : <div class="animal-image-missing" aria-label="Imagen no disponible">Imagen no disponible</div>}
  <h2>{name}</h2>
</a>
