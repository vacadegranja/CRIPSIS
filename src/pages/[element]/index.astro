---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LetterTitle from "../../components/LetterTitle.astro";
import AnimalCard from "../../components/AnimalCard.astro";
import { elements, animalsByElement } from "../../data/animals.js";

export function getStaticPaths() {
  return Object.entries(elements).map(([element, elementData]) => ({
    params: { element },
    props: { elementData },
  }));
}

const { element } = Astro.params;
const { elementData } = Astro.props;
const animals = animalsByElement(element);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<BaseLayout
  title={`${elementData.name} — CRIPSIS`}
  description={elementData.description}
  theme={elementData.theme}
  particleImage={elementData.texture}
>
  <div class="hero category-hero" slot="hero">
    <LetterTitle text={elementData.name} />
    <p>{elementData.description}</p>
  </div>

  {
    animals.length ? (
      <section class="animal-grid" aria-label={`Animales de ${elementData.name}`}>
        {animals.map((animal) => (
          <AnimalCard
            href={`${base}${element}/${animal.slug}/`}
            name={animal.name}
            image={asset(animal.cover)}
            alt={animal.alt}
          />
        ))}
      </section>
    ) : (
      <p class="empty-state">Próximamente aparecerán animales de {elementData.name}.</p>
    )
  }
</BaseLayout>
