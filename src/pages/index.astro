---
import BaseLayout from "../layouts/BaseLayout.astro";
import { elements } from "../data/animals.js";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const elementKeys = ["aire", "tierra", "agua"] as const;
const entries = elementKeys.map((key) => ({
  key,
  ...elements[key],
}));
---

<BaseLayout
  title="CRIPSIS"
  theme="home-theme"
  home
>
  <div class="hero hero-home" slot="hero">
    <h1 class="home-logo" aria-label="CRIPSIS" tabindex="0">
      <svg viewBox="0 0 453.94 62.87" aria-hidden="true">
