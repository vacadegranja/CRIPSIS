        </g>
        <g class="home-logo-glyph" tabindex="0" aria-label="R">
          <path d="M133.23,62.87c-10.62,0-16.47-5.85-16.47-16.47v-9.58h-4.49v17.07c0,5.71-3.27,8.98-8.98,8.98h-16.47c-5.71,0-8.98-3.27-8.98-8.98V8.98c0-5.71,3.27-8.98,8.98-8.98h46.41c11.7,0,16.47,5.29,16.47,18.26s-4.19,18.56-14.45,18.56h-8.01v.75c0,1.12.38,1.5,1.5,1.5h11.98c5.71,0,8.98,3.27,8.98,8.98v5.84c0,5.71-3.27,8.98-8.98,8.98h-7.49ZM113.77,10.48c-1.12,0-1.5.38-1.5,1.5v12.87c0,1.12.38,1.5,1.5,1.5h1.5c1.12,0,1.5-.38,1.5-1.5v-12.87c0-1.12-.38-1.5-1.5-1.5,0,0-1.5,0-1.5,0Z"/>
        </g>
        <g class="home-logo-glyph" tabindex="0" aria-label="I">
          <rect x="154.18" width="34.43" height="62.87" rx="8.98" ry="8.98"/>
        </g>
        <g class="home-logo-glyph" tabindex="0" aria-label="P">
          <path d="M242.88,0h-40.79c-5.72,0-8.99,3.27-8.99,8.98v44.91c0,5.71,3.27,8.98,8.98,8.98h16.47c5.71,0,8.98-3.27,8.98-8.98v-6.74h15.35c10.62,0,16.47-5.85,16.47-16.47v-14.22c-.01-10.61-5.86-16.46-16.47-16.46ZM230.52,26.72c0,.9-.68,1.57-1.57,1.57h-.6c-.9,0-1.57-.68-1.57-1.57v-14.67c0-.9.68-1.57,1.57-1.57h.6c.9,0,1.57.68,1.57,1.57v14.67Z"/>
